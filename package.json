{
  "name": "partyhause",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "build:web": "npx vite build",
    "build:mobile": "node ./scripts/build-mobile-pwa.cjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && tsc -p packages/core/tsconfig.json && npm --workspace apps/mobile run typecheck",
    "build:check": "npm run typecheck && npm run audit:contracts && npx vite build",
    "lint": "eslint .",
    "preview": "npx vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:mobile-release": "vitest run src/test/mobile-release-route-graph.test.ts src/test/mobile-ios-release-config.test.ts",
    "test:migrations": "prisma migrate deploy && prisma db execute --file prisma/migrations/20260905000100_database_functions/migration.sql && prisma db execute --file prisma/migrations/20260905000100_database_functions/migration.sql && prisma migrate deploy && node scripts/verify-migration-invariants.cjs && npx tsx scripts/verify-mvp-concurrency.ts && npx tsx scripts/verify-signup-transaction.ts && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "doctor:mobile": "npx expo-doctor@1.20.4 apps/mobile",
    "test:coverage": "vitest run --coverage",
    "smoke-test:migration": "node ./scripts/smoke-test-migration.js",
    "server": "tsx server/index.ts",
    "dev:api": "tsx watch server/dev-api.ts",
    "dev:docker": "docker-compose up --build",
    "audit:endpoints": "node scripts/audit-endpoints.cjs",
    "audit:contracts": "node scripts/audit-contracts.cjs",
    "audit:mobile-bundle": "node scripts/audit-mobile-bundle.cjs",
    "build:ios:export": "npm --workspace apps/mobile run export:ios && npm run audit:mobile-bundle"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/msal-browser": "^5.16.0",
    "@azure/storage-blob": "^12.32.0",
    "@azure/web-pubsub": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "12.43.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.41.0",
    "mailersend": "^2.6.0",
    "multer": "^2.2.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-confetti": "^6.4.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.46.2",
    "react-router-dom": "^7.8.2",
    "resend": "^6.0.3",
