# Database (PostgreSQL). Supplied to Prisma via prisma.config.ts.
# Local development against a Postgres on the default port:
DATABASE_URL=postgresql://localhost:5432/partyhause
# The API falls back to assembling a connection string from these parts with
# sslmode=require when DATABASE_URL is absent or unparseable.
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# JWT signing secret for self-hosted auth.
# Required in production, where the server refuses to start if it is empty,
# equal to the committed dev fallback, or shorter than 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email Service (Resend)
# Get your API key at https://resend.com/api-keys
# RESEND_FROM_EMAIL must be a verified sending address on your Resend account
# (e.g. PartyHause <noreply@partyhause.com> or onboarding@resend.dev for testing)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=PartyHause <noreply@partyhause.com>
RESEND_FROM_NAME=PartyHause
# Optional: client-side fallbacks (not recommended for production)
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM_EMAIL=PartyHause <noreply@partyhause.com>

# Frontend API base URL (the public URL of the API container / serverless functions)
# Leave empty to use same-origin /api/* (recommended when API is served from the same host)
VITE_API_URL=

# App Environment
VITE_APP_ENV=development

# Application Configuration
VITE_APP_NAME=PartyHause
VITE_APP_URL=http://localhost:5173

# CORS - allowed origin(s) for the API server (comma-separated, or * for any)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Azure Blob Storage (event invite images)
# The API uploads to this container server-side. Set either a full connection
# string OR the account name + key.
AZURE_STORAGE_ACCOUNT=stphgipkzrenusqpy
AZURE_STORAGE_IMAGE_CONTAINER=event-invites
AZURE_STORAGE_BLOB_ENDPOINT=https://stphgipkzrenusqpy.blob.core.windows.net/
# Full connection string (preferred in production):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=stphgipkzrenusqpy;AccountKey=<key>;EndpointSuffix=core.windows.net
# Or just the account key (used with AZURE_STORAGE_ACCOUNT to build a client):
# AZURE_STORAGE_ACCOUNT_KEY=<key>
