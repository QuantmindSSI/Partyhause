{
  "functions": {
    "api/email.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/health.ts": {
      "memory": 128,
      "maxDuration": 5
    },
    "api/email-webhook.ts": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/event-templates.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/create-event-from-template.ts": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/events.ts": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/guests.ts": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/timeline.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/email"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/email-webhook",
      "destination": "/api/email-webhook"
    },
    {
      "source": "/api/event-templates",
      "destination": "/api/event-templates"
    },
    {
      "source": "/api/create-event-from-template",
      "destination": "/api/create-event-from-template"
    },
    {
      "source": "/api/events/:id/guests",
      "destination": "/api/guests"
    },
    {
      "source": "/api/events/:id/timeline",
      "destination": "/api/timeline"
    },
    {
      "source": "/api/events/:path*",
      "destination": "/api/events"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/index.html"
    }
  ],
  "outputDirectory": "dist"
}