{
  "functions": {
    "api/email.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/health.ts": {
      "memory": 128,
      "maxDuration": 5
    }
  },
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/email"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/index.html"
    }
  ],
  "outputDirectory": "dist"
}